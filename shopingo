<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ShopinGo</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #121212;
      color: #fff;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    /* General page styling */
    .container {
      padding: 20px;
    }

    h1, h2, p {
      text-align: center;
    }

    /* Header */
    header {
      background: #333;
      padding: 20px;
      text-align: center;
    }

    header h1 {
      color: #FFD700;
      font-size: 36px;
    }

    /* Main commercial city section */
    .main-content {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      margin-top: 40px;
    }

    .catalog {
      background: #2C2C2C;
      border-radius: 10px;
      padding: 20px;
      margin: 10px;
      width: 30%;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.5);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .catalog:hover {
      transform: scale(1.05);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.7);
    }

    .catalog h2 {
      color: #FFD700;
      font-size: 24px;
      margin-bottom: 10px;
    }

    .catalog p {
      color: #bbb;
      font-size: 16px;
    }

    /* Products in each catalog */
    .product {
      background: #3A3A3A;
      margin: 10px 0;
      padding: 10px;
      border-radius: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .product img {
      width: 50px;
      height: 50px;
      border-radius: 5px;
    }

    .product .product-info {
      flex-grow: 1;
      margin-left: 15px;
    }

    .product .product-info h3 {
      color: #FFD700;
      margin: 0;
    }

    .product .product-info p {
      color: #bbb;
      font-size: 14px;
    }

    .btn {
      background-color: #FFD700;
      color: #121212;
      font-size: 16px;
      padding: 10px 15px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      margin-left: 10px;
      transition: transform 0.3s ease, background-color 0.3s ease;
    }

    .btn:hover {
      transform: scale(1.1);
      background-color: #FF6347;
    }

    /* Footer */
    footer {
      background: #333;
      color: #fff;
      padding: 20px 0;
      text-align: center;
      margin-top: 40px;
    }

    footer p {
      margin: 0;
    }

  </style>
</head>
<body>

  <!-- Header of ShopinGo -->
